{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Alchemy",
  "description": "Open-source (Apache 2.0) runtime by Galaxy for fast, isolated, strongly typed compute functions. Each invocation runs in its own Firecracker microVM.",
  "colors": {
    "primary": "#005EFF",
    "light": "#005EFF",
    "dark": "#005EFF"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#0A0A0A"
    }
  },
  "appearance": {
    "default": "dark",
    "strict": false
  },
  "logo": {
    "light": "/assets/alchemy-light.svg",
    "dark": "/assets/alchemy-dark.svg",
    "href": "https://github.com/galaxy-io/alchemy"
  },
  "favicon": "/assets/favicon.svg",
  "fonts": {
    "family": "ABC Diatype",
    "weight": 400,
    "source": "https://cdn.getgalaxy.io/fonts/Diatype/ABCDiatype-Regular.woff2",
    "format": "woff2",
    "heading": {
      "family": "ABC Diatype",
      "weight": 500,
      "source": "https://cdn.getgalaxy.io/fonts/Diatype/ABCDiatype-Medium.woff2",
      "format": "woff2"
    }
  },
  "icons": {
    "library": "fontawesome"
  },
  "styling": {
    "eyebrows": "section",
    "codeblocks": {
      "theme": {
        "light": "github-light-default",
        "dark": "github-dark-default"
      }
    }
  },
  "interaction": {
    "drilldown": true
  },
  "search": {
    "prompt": "Search"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "claude",
      "chatgpt",
      "cursor",
      "mcp"
    ],
    "display": "header"
  },
  "navbar": {
    "links": [
      {
        "type": "github",
        "href": "https://github.com/galaxy-io/alchemy"
      },
      {
        "label": "Join the Slack community",
        "icon": "slack",
        "href": "https://join.slack.com/t/galaxy-io-community/shared_invite/zt-45qln0zg5-9CTvKVXugvh3sEhpD6KzJQ"
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/galaxy-io/alchemy",
      "slack": "https://join.slack.com/t/galaxy-io-community/shared_invite/zt-45qln0zg5-9CTvKVXugvh3sEhpD6KzJQ",
      "website": "https://www.getgalaxy.io"
    }
  },
  "seo": {
    "indexing": "navigable"
  },
  "thumbnails": {
    "appearance": "dark"
  },
  "errors": {
    "404": {
      "redirect": false
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": [
          "pages/get-started/introduction",
          "pages/get-started/quickstart",
          "pages/get-started/installation"
        ]
      },
      {
        "group": "Guides",
        "pages": [
          "pages/guides/python-function",
          "pages/guides/typescript-function",
          "pages/guides/go-function",
          "pages/guides/rust-function",
          "pages/guides/templates",
          "pages/guides/image-function",
          "pages/guides/troubleshooting"
        ]
      },
      {
        "group": "Usage",
        "pages": [
          "pages/usage/web",
          "pages/usage/http"
        ]
      },
      {
        "group": "Concepts",
        "pages": [
          "pages/concepts/overview",
          "pages/concepts/architecture",
          "pages/concepts/functions-and-versions",
          "pages/concepts/contracts",
          "pages/concepts/invocations",
          "pages/concepts/runtimes-and-builds",
          "pages/concepts/isolation",
          "pages/concepts/secrets",
          "pages/concepts/logs"
        ]
      },
      {
        "group": "Deployment",
        "pages": [
          "pages/deployment/overview",
          "pages/deployment/kubernetes",
          "pages/deployment/kvm-nodes",
          "pages/deployment/configuration",
          "pages/deployment/storage",
          "pages/deployment/authentication",
          "pages/deployment/autoscaling"
        ]
      },
      {
        "group": "API reference",
        "pages": [
          "pages/api-reference/introduction",
          "pages/api-reference/functions",
          "pages/api-reference/invocations",
          "pages/api-reference/secrets",
          "pages/api-reference/hosts",
          "pages/api-reference/metrics",
          "pages/api-reference/http"
        ]
      },
      {
        "group": "Contributing",
        "pages": [
          "pages/contributing/local-development",
          "pages/contributing/style-and-testing"
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/pages/get-started/introduction"
    }
  ]
}
