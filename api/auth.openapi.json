  "security": [],
  "tags": [
    {
      "name": "auth.v1.AuthService",
      "description": "AuthService is an app's identity surface. It is optional: with no\n provider configured the server leaves it unimplemented and the API is\n unauthenticated.\n\n The session RPCs run before the caller holds a bearer token, so they are\n the server's only public procedures and carry no tenant_id — there is no\n tenant until sign-in completes. Everything else is authenticated and\n scoped to the caller's own tenant."
    }
  ]
