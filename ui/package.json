{
  "name": "@galaxy-io/alchemy-ui",
  "version": "0.8.0",
  "description": "Alchemy's web UI as a Galaxy module a host app mounts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/galaxy-io/alchemy.git",
    "directory": "ui"
  },
  "bugs": "https://github.com/galaxy-io/alchemy/issues",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./paths": {
      "types": "./dist/module/paths.d.ts",
      "import": "./dist/module/paths.js"
    },
    "./links": {
      "types": "./dist/module/links.d.ts",
      "import": "./dist/module/links.js"
    },
    "./routes": {
      "types": "./dist/module/routes.d.ts",
      "import": "./dist/module/routes.js"
    },
    "./AlchemyLayout": {
      "types": "./dist/module/AlchemyLayout.d.ts",
      "import": "./dist/module/AlchemyLayout.js"
    },
    "./commands": {
      "types": "./dist/module/commands.d.ts",
      "import": "./dist/module/commands.js"
    },
    "./pages/NotFoundPage": {
      "types": "./dist/pages/NotFoundPage.d.ts",
      "import": "./dist/pages/NotFoundPage.js"
    },
    "./pages/ObservabilityPage": {
      "types": "./dist/pages/observability/ObservabilityPage.d.ts",
      "import": "./dist/pages/observability/ObservabilityPage.js"
    },
    "./pages/FunctionsPage": {
      "types": "./dist/pages/functions/FunctionsPage.d.ts",
      "import": "./dist/pages/functions/FunctionsPage.js"
    },
    "./pages/FunctionPage": {
      "types": "./dist/pages/functions/FunctionPage.d.ts",
      "import": "./dist/pages/functions/FunctionPage.js"
    },
    "./pages/FunctionOverviewPage": {
      "types": "./dist/pages/functions/FunctionOverviewPage.d.ts",
      "import": "./dist/pages/functions/FunctionOverviewPage.js"
    },
    "./pages/FunctionWorkbenchPage": {
      "types": "./dist/pages/functions/FunctionWorkbenchPage.d.ts",
      "import": "./dist/pages/functions/FunctionWorkbenchPage.js"
    },
    "./pages/FunctionContractPage": {
      "types": "./dist/pages/functions/FunctionContractPage.d.ts",
      "import": "./dist/pages/functions/FunctionContractPage.js"
    },
    "./pages/FunctionInvocationsPage": {
      "types": "./dist/pages/functions/FunctionInvocationsPage.d.ts",
      "import": "./dist/pages/functions/FunctionInvocationsPage.js"
    },
    "./pages/FunctionVersionsPage": {
      "types": "./dist/pages/functions/FunctionVersionsPage.d.ts",
      "import": "./dist/pages/functions/FunctionVersionsPage.js"
    },
    "./pages/FunctionSettingsPage": {
      "types": "./dist/pages/functions/FunctionSettingsPage.d.ts",
      "import": "./dist/pages/functions/FunctionSettingsPage.js"
    },
    "./pages/InvocationsPage": {
      "types": "./dist/pages/invocations/InvocationsPage.d.ts",
      "import": "./dist/pages/invocations/InvocationsPage.js"
    },
    "./pages/HostsPage": {
      "types": "./dist/pages/hosts/HostsPage.d.ts",
      "import": "./dist/pages/hosts/HostsPage.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lib": "vite build --config vite.lib.config.ts",
    "preview": "vite preview",
    "codegen": "buf generate",
    "typecheck": "tsc --noEmit",
    "typecheck:lib": "tsc -p tsconfig.lib.json --noEmit",
    "check:package": "publint --strict && node scripts/check-package.mjs",
    "check:host": "tsc -p fixtures/host/tsconfig.json && vite build --config fixtures/host/vite.config.ts",
    "check": "pnpm typecheck && pnpm typecheck:lib && pnpm lint:check && pnpm format:check && pnpm build && pnpm build:lib && pnpm check:package && pnpm check:host",
    "clean": "rm -rf build dist",
    "format": "biome check --write",
    "format:check": "biome check",
    "lint": "biome lint --write",
    "lint:check": "biome lint",
    "prepublishOnly": "pnpm build:lib && pnpm check:package && pnpm check:host"
  },
  "dependencies": {
    "@linaria/core": "^7.0.0",
    "@linaria/react": "^7.0.1",
    "@phosphor-icons/react": "^2.1.10",
    "apache-arrow": "^21.2.0",
    "ts-pattern": "^5.9.0",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@bufbuild/protobuf": "^2.9.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@connectrpc/connect": "^2.1.0",
    "@connectrpc/connect-query": "^2.1.1",
    "@galaxy-io/dls": "^2.13.2",
    "@lezer/highlight": "^1.2.3",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-router": "^1.141.2",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.6",
    "@uiw/codemirror-extensions-langs": "^4.25.10",
    "@uiw/codemirror-themes": "^4.25.10",
    "@uiw/react-codemirror": "^4.25.10",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@biomejs/biome": "^2.5.15",
    "@bufbuild/buf": "^1.57.2",
    "@bufbuild/protobuf": "^2.9.0",
    "@bufbuild/protoc-gen-es": "^2.9.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@connectrpc/connect": "^2.1.0",
    "@connectrpc/connect-query": "^2.1.1",
    "@connectrpc/connect-web": "^2.1.0",
    "@galaxy-io/dls": "^2.13.2",
    "@lezer/highlight": "^1.2.3",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-router": "^1.141.2",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.6",
    "@tanstack/router-plugin": "^1.141.2",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@uiw/codemirror-extensions-langs": "^4.25.10",
    "@uiw/codemirror-themes": "^4.25.10",
    "@uiw/react-codemirror": "^4.25.10",
    "@vitejs/plugin-react": "^6.0.2",
    "@wyw-in-js/vite": "^1.1.0",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "publint": "^0.3.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.9.3",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^5.1.2"
  }
}
