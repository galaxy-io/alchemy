{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "skip-changelog": true,
  "bump-minor-pre-major": true,
  "packages": {
    ".": {
      "release-type": "go",
      "initial-version": "0.0.1",
      "include-component-in-tag": false,
      "exclude-paths": [
        "examples",
        "api"
      ],
      "extra-files": [
        {
          "type": "yaml",
          "path": "charts/alchemy/Chart.yaml",
          "jsonpath": "$.version"
        },
        {
          "type": "yaml",
          "path": "charts/alchemy/Chart.yaml",
          "jsonpath": "$.appVersion"
        }
      ]
    },
    "ui": {
      "release-type": "node",
      "component": "alchemy-ui",
      "include-v-in-tag": false
    },
    "api": {
      "release-type": "go",
      "initial-version": "0.3.0",
      "component": "api",
      "include-component-in-tag": true,
      "tag-separator": "/"
    }
  }
}
